{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "vice",
            "request": "launch",
            "name": "Launch Vice",
            "program": "${workspaceFolder}/build/The Munching Millipede.prg",
            "args": "-8 \"${workspaceFolder}/build/The Munching Millipede.d64\" -autostart \"${workspaceFolder}/build/The Munching Millipede.d64\"",
            "preLaunchTask": "${defaultBuildTask}"
        },
        {
            "type": "vice",
            "request": "attach",
            "name": "Attach Vice",
            "hostname": "localhost",
            "port": 6502,
            "preLaunchTask": "${defaultBuildTask}"
        }
    ]
}
